# iOS native — local config + generated Xcode project
ios-native/Config.local.xcconfig

# The .xcodeproj is generated by `xcodegen`, so it stays out of git — but
# SPM's Package.resolved lives INSIDE it. Ignoring the whole bundle meant
# every regeneration threw the resolved versions away, so Xcode re-fetched
# all four packages from GitHub and reported "missing package product"
# until that finished (and could silently drift to newer versions).
# Git won't look inside an excluded directory, so un-ignore the path one
# level at a time down to that single file.
ios-native/MyBookLab.xcodeproj/*
!ios-native/MyBookLab.xcodeproj/project.xcworkspace/
ios-native/MyBookLab.xcodeproj/project.xcworkspace/*
!ios-native/MyBookLab.xcodeproj/project.xcworkspace/xcshareddata/
ios-native/MyBookLab.xcodeproj/project.xcworkspace/xcshareddata/*
!ios-native/MyBookLab.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
ios-native/MyBookLab.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!ios-native/MyBookLab.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
