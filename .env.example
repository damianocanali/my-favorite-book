# Required for AI features — set these in Vercel Dashboard > Settings > Environment Variables
ANTHROPIC_API_KEY=sk-ant-your-key-here
TOGETHER_API_KEY=your-together-key-here

# Stripe publishable key (test pk_test_... in dev/preview, live pk_live_... in production)
# This value is safe to expose to the frontend bundle.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_change_me

# ── App Attest (paid AI endpoint protection; see api/_appAttest.js) ──
# off (default) | log (verify + log only) | enforce (reject invalid
# assertions; absent ones still work in the reduced unattested tier).
# Roll out: log → watch Vercel logs → enforce.
ATTEST_MODE=log
# Daily image cap for requests WITHOUT a valid assertion (web + old
# builds). Attested requests use DAILY_IMAGE_LIMIT (default 50).
DAILY_IMAGE_LIMIT_UNATTESTED=20
# Defaults match ios-native/project.yml; override only if those change.
# APP_ATTEST_TEAM_ID=G53XBRCRVU
# APP_ATTEST_BUNDLE_ID=com.myfavoritebook.app
# Accept Apple's development attestation environment even in production
# (normally only allowed on preview deployments).
# APP_ATTEST_ALLOW_DEV=true

# ── IP hashing (lib/school/crypto.js ipHashKey) ──
# HMAC key for client IPs in rate-limit keys (incl. everything sent to
# Upstash) and student sign-in attempt rows. MUST differ from
# STUDENT_SECRET_PEPPER. Until set, the pepper is used with a warning.
# Generate: openssl rand -hex 32
# IP_HASH_KEY=

# ── Schools billing (Stage 4; lib/school/pricing.js, api/school/checkout.js) ──
# Stripe Price ids (yearly, per seat, USD). The owner creates them in Stripe;
# the amounts must match lib/school/pricing.js ($19 / $15 founding / $17).
# STRIPE_PRICE_SEAT=price_...
# STRIPE_PRICE_SEAT_FOUNDING=price_...
# STRIPE_PRICE_SCHOOL_SEAT=price_...
# Optional: the school plan's founding Price. Unset = STRIPE_PRICE_SEAT_FOUNDING
# (both $15 by default, SCHOOL_PLAN_FOUNDING_PRICE_CENTS in lib/school/pricing.js).
# STRIPE_PRICE_SCHOOL_SEAT_FOUNDING=price_...
# Extra school email domains that verify a teacher automatically (comma-
# separated, matched on whole labels from the right; *.edu and *.k12.<st>.us
# are built in). Example: SCHOOL_EMAIL_DOMAINS=district.org,sch.uk
# SCHOOL_EMAIL_DOMAINS=
