{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "ai_disclosure.continue": {
      "comment": "First-use AI disclosure for family accounts (App Store 5.1.2(i)), AIDisclosureView.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand, continue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho capito, continua"
          }
        }
      }
    },
    "ai_disclosure.intro": {
      "comment": "First-use AI disclosure for family accounts (App Store 5.1.2(i)), AIDisclosureView.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For grown-ups: My Book Lab uses outside AI services for Story Buddy and pictures. Here is what they receive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per gli adulti: My Book Lab usa servizi di IA esterni per Story Buddy e per le immagini. Ecco cosa ricevono."
          }
        }
      }
    },
    "ai_disclosure.pictures": {
      "comment": "First-use AI disclosure for family accounts (App Store 5.1.2(i)), AIDisclosureView.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Together AI draws the pictures from that written scene description. If you use a photo avatar, the photo you choose is also sent to Together AI to turn it into a cartoon; we don't keep the photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Together AI disegna le immagini a partire da quella descrizione della scena. Se usi un avatar da foto, anche la foto che scegli viene inviata a Together AI per trasformarla in un cartone animato; non conserviamo la foto."
          }
        }
      }
    },
    "ai_disclosure.privacy_link": {
      "comment": "First-use AI disclosure for family accounts (App Store 5.1.2(i)), AIDisclosureView.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the Privacy Policy"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi l'Informativa sulla privacy"
          }
        }
      }
    },
    "ai_disclosure.safety": {
      "comment": "First-use AI disclosure for family accounts (App Store 5.1.2(i)), AIDisclosureView.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI checks the words and every finished picture for safety."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI controlla la sicurezza delle parole e di ogni immagine finita."
          }
        }
      }
    },
    "ai_disclosure.story_buddy": {
      "comment": "First-use AI disclosure for family accounts (App Store 5.1.2(i)), AIDisclosureView.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic (Claude) reads the story text your child writes, to give Story Buddy help and to describe each picture to draw."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic (Claude) legge il testo scritto da chi crea la storia, per l'aiuto di Story Buddy e per descrivere ogni immagine da disegnare."
          }
        }
      }
    },
    "ai_disclosure.title": {
      "comment": "First-use AI disclosure for family accounts (App Store 5.1.2(i)), AIDisclosureView.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the AI helpers work"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come funzionano gli assistenti IA"
          }
        }
      }
    },
    "ai_disclosure.use": {
      "comment": "First-use AI disclosure for family accounts (App Store 5.1.2(i)), AIDisclosureView.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These services get only what each request needs. The Privacy Policy says how long each one keeps it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi servizi ricevono solo ciò che serve per ogni richiesta. L'Informativa sulla privacy indica per quanto tempo ciascuno lo conserva."
          }
        }
      }
    },
    "errors.ai.image_flagged": {
      "comment": "A generated picture failed safety screening and was not kept (api/_aiGuard.js moderateImage).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That picture didn't turn out right. Try again with different words."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa immagine non è venuta bene. Riprova con parole diverse."
          }
        }
      }
    },
