    },
    "Subscription auto-renews unless canceled at least 24 hours before the end of the period. Manage or cancel in Settings → Apple ID → Subscriptions.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abbonamento si rinnova automaticamente, salvo disdetta almeno 24 ore prima della fine del periodo. Puoi gestirlo o disdirlo in Impostazioni → ID Apple → Abbonamenti."
          }
        }
      }
    },
