    "Stuck? Tap a button and I'll help with ideas — I never write your story for you. ✨": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sai come continuare? Tocca un pulsante e ti do qualche idea: la tua storia non la scrivo mai io. ✨"
          }
        }
      }
    },
    "Subscribe for unlimited stories": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonati per storie illimitate"
          }
        }
      }
    },
    "Subscription auto-renews unless canceled at least 24 hours before the end of the period. Manage or cancel in Settings → Apple ID → Subscriptions.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abbonamento si rinnova automaticamente, salvo disdetta almeno 24 ore prima della fine del periodo. Puoi gestirlo o disdirlo in Impostazioni → ID Apple → Abbonamenti."
          }
        }
      }
    },
    "Subtotal": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtotale"
          }
        }
      }
    },
    "Summary": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riepilogo"
          }
        }
      }
    },
    "Sync books across devices, order printed copies, and pick up where you left off.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza i libri su tutti i dispositivi, ordina le copie stampate e riprendi da dove hai lasciato."
          }
        }
      }
    },
    "Take a break": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare una pausa"
          }
        }
