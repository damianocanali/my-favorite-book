    "school.teacher.roster.delete_dialog.heading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %@ permanently?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare definitivamente %@?"
          }
        }
      }
    },
    "school.teacher.roster.delete_dialog.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes %@'s class account and everything in it right now: books, pictures, hand-ins, feedback, Writing Year pages and check-ins. It can't be undone, and we can't get it back. To keep a copy, export the class data first."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina subito l'account di classe di %@ e tutto il suo contenuto: libri, immagini, consegne, commenti, pagine del Mio anno di scrittura e check-in. L'operazione non si può annullare e non potremo recuperare nulla. Per tenerne una copia, esporta prima i dati della classe."
          }
        }
      }
    },
    "school.teacher.roster.delete_dialog.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type %@ to confirm"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi %@ per confermare"
          }
        }
      }
    },
    "school.teacher.roster.delete_dialog.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete forever"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina per sempre"
          }
        }
      }
    },
