    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per scattare una foto e trasformarla nel tuo avatar in stile cartone animato. La foto originale non viene mai salvata: resta solo l'avatar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to take a photo for your cartoon avatar. The original photo is never saved — only the cartoon version is kept."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per farti accedere di nuovo al tuo account in modo sicuro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to securely sign you back in to your account."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per dettare la tua storia quando tocchi il pulsante del microfono."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to dictate your story when you tap the microphone button."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per scegliere una foto e trasformarla nel tuo avatar in stile cartone animato. La foto originale non viene mai salvata: resta solo l'avatar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to pick a photo for your cartoon avatar. The original photo is never saved — only the cartoon version is kept."
          }
        }
      }
    }
