# Allow npm install to proceed when peer dependencies mismatch.
#
# Required because:
#   - @capacitor-community/stripe@7 (matching our Capacitor 7) declares peer
#     React ^17 || ^18 but we're on React 19. The plugin is hooks/refs only
#     and works fine at runtime; the peer range just hasn't been refreshed.
#
# Vercel CI uses strict peer resolution by default and fails without this.
legacy-peer-deps=true
