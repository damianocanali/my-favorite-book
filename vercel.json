{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/cron/purge-deletions", "schedule": "0 3 * * *" },
    { "path": "/api/cron/teacher-summary", "schedule": "30 1 * * *" }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
